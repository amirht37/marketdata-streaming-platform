          "id": 1,
          "title": "Total Trades",
          "description": "Number of trades recorded in the selected time range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
