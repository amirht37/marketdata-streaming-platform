                      "datasource": {
                        "name": "ag0n85zkrwlj4b"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {},
                        "pluginVersion": "4.22.1",
                        "queryType": "table",
                        "rawSql": "SELECT symbol,count() AS total_trades\nFROM crypto_db.crypto_trades\nWHERE $__timeFilter(event_ts)\n  AND (\n      '${side}' = '.*'\n      OR side = '${side}'\n  )\n    AND (\n    '${symbol}' = '.*'\n    OR symbol = '${symbol}'\n  )\nGROUP BY symbol\n"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
