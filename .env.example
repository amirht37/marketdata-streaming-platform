# =============================================================================
# Copy this file to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored. NEVER commit it.
# Variables marked REQUIRED make `docker compose up` fail if they are empty.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me            # REQUIRED
POSTGRES_DB=crypto_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- ClickHouse ---------------------------------------------------------------
CLICKHOUSE_DB=crypto_db
CLICKHOUSE_USER=clickhouse_admin
CLICKHOUSE_PASSWORD=change_me          # REQUIRED

# --- MinIO (S3-compatible storage; also used by Kafka Connect / Iceberg) -------
MINIO_ROOT_USER=change_me              # REQUIRED
MINIO_ROOT_PASSWORD=change_me_too      # REQUIRED (min 8 chars)
AWS_REGION=us-east-1

# --- Grafana ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me       # REQUIRED

# --- Redis --------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
